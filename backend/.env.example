# ==============================
# GAMA - SERVIDOR DE PRODUÇÃO
# ==============================

# Provedor padrão: OpenRouter (Groq removido)
LLM_PROVIDER=openrouter

# Chave OpenRouter (obrigatória em produção)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://gama-production-592b.up.railway.app
OPENROUTER_APP_TITLE=Frequencia40-Gamma

# ── Modelos (OpenRouter) ─────────────────────────────────────────────
# Programar / padrão (código, debug, arquitetura)
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.4-mini
CODING_MODEL=openai/gpt-5.4-mini

# Conversa / Talk / voz (rápido e econômico)
CONVERSATION_MODEL=openai/gpt-5.4-mini

# Visão / Image Analyzer
VISION_MODEL=openai/gpt-5.4-mini

# Lista exposta em GET /models
OPENROUTER_MODELS=deepseek/deepseek-chat,openai/gpt-5.4-mini

# Persistência
DATA_DIR=/data
APP_NAME=Frequencia40-Gamma
APP_URL=https://gama-production-592b.up.railway.app

# Busca web
WEB_SEARCH_ENABLED=1
WEB_SEARCH_TIMEOUT=12
WEB_SEARCH_MODE=aggressive
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# Ollama só se LLM_PROVIDER=ollama (legado/local)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
