# ==============================
# GAMA - SERVIDOR DE PRODUÇÃO
# ==============================

# O backend usa Ollama no servidor.
LLM_PROVIDER=ollama
OLLAMA_URL=http://lhama.railway.internal:11434

# Modelo principal do Gama.
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
OLLAMA_MODELS=qwen2.5:1.5b

# Persistência do backend.
DATA_DIR=/data
APP_NAME=Frequencia40-Gamma
APP_URL=https://gama-production-592b.up.railway.app

# Busca web opcional.
WEB_SEARCH_ENABLED=1
WEB_SEARCH_TIMEOUT=12
WEB_SEARCH_MODE=aggressive

# Opcional: configure uma destas chaves se quiser um provedor de busca pago.
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
