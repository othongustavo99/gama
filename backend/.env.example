# ==============================
# GAMA - SERVIDOR (copie para .env; NUNCA commite o .env)
# ==============================

# Provedor: openrouter (padrão) ou ollama (local)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://SEU-APP.up.railway.app
OPENROUTER_APP_TITLE=Gama

# ── Segurança (OBRIGATÓRIO em produção) ───────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# O app envia essa chave em X-API-Key (flutter run --dart-define=GAMA_API_KEY=...)
GAMA_API_KEY=troque-por-uma-chave-longa
GAMA_REQUIRE_API_KEY=1
# Em produção, exija também token Google em rotas com dados privados.
# Para desenvolvimento sem login, use 0 conscientemente (modo menos seguro).
GAMA_REQUIRE_AUTH=1
# Audiences aceitas nos ID tokens. No Android, use o Web client ID enviado
# como GOOGLE_SERVER_CLIENT_ID no build Flutter.
GOOGLE_OAUTH_CLIENT_IDS=SEU_WEB_CLIENT_ID.apps.googleusercontent.com
# IDs de clientes nativos que podem aparecer em `azp` (Android/desktop).
# Isso não os torna audiences válidas; copie os IDs completos do Google Cloud.
GOOGLE_OAUTH_AUTHORIZED_PARTY_IDS=SEU_ANDROID_CLIENT_ID.apps.googleusercontent.com,SEU_DESKTOP_CLIENT_ID.apps.googleusercontent.com
# Restrinja se tiver cliente web. Padrão "*" (apps nativos não usam CORS).
CORS_ORIGINS=*
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=120
GAMA_IMAGE_DAILY_LIMIT=10
GAMA_VIDEO_DAILY_LIMIT=2
# Proxies confiáveis na frente do app (Railway/Render = 1)
TRUSTED_PROXY_HOPS=1

# ── Modelos (confirme os IDs em openrouter.ai/models) ─────────────────
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.4-mini
CODING_MODEL=openai/gpt-5.4-mini
CONVERSATION_MODEL=openai/gpt-5.4-mini
VISION_MODEL=openai/gpt-5.4-mini
OPENROUTER_MODELS=deepseek/deepseek-chat,openai/gpt-5.4-mini
MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.6
LLM_RETRIES=3

# ── Agente com ferramentas: o modelo decide quando pesquisar/calcular/lembrar ──
AGENT_TOOLS_ENABLED=1
MAX_TOOL_ROUNDS=4
MAX_TOOL_CALLS=6

# Persistência (monte um Volume ao serviço da API; recomendado: /data).
# DATA_DIR pode permanecer /data; se o mount estiver em outro caminho o backend
# usa automaticamente RAILWAY_VOLUME_MOUNT_PATH fornecido pelo Railway.
DATA_DIR=/data
# Limites do armazenamento de artefatos no volume Railway (5 GB): reserva 2 GB
# para índices, memória e demais dados da aplicação. Retenção padrão de 7 dias.
ARTIFACT_STORAGE_LIMIT_MB=3072
ARTIFACT_MAX_FILE_MB=100
MAX_UPLOAD_MB=100
# Deve ser pelo menos 5 MB maior que MAX_UPLOAD_MB para acomodar multipart.
MAX_BODY_MB=105
ARTIFACT_TTL_HOURS=168
APP_NAME=Gama
APP_URL=https://SEU-APP.up.railway.app

# OCR opcional para PDFs digitalizados (Docker já instala Tesseract por padrão).
# Requer PyMuPDF + Tesseract instalados no sistema; idiomas separados por +.
GAMA_OCR_LANG=por+eng

# ── Geração/análise de vídeo (OpenRouter Videos API) ─────────────────
VIDEO_GEN_ENABLED=1
VIDEO_GEN_MODEL=bytedance/seedance-2.0-mini
VIDEO_GEN_DEFAULT_DURATION=5
VIDEO_GEN_MAX_DURATION=10
VIDEO_GEN_DEFAULT_RESOLUTION=480p
# APP_URL deve ser a origem HTTPS pública da API para referências de vídeo assinadas.
# Open-Meteo não exige chave de API para uso não comercial; confira os termos se usar comercialmente.

# Busca web. "balanced" pesquisa só quando faz sentido (modo clássico);
# com AGENT_TOOLS_ENABLED=1 essa heurística nem é usada. Evite "aggressive":
# ele pesquisa em TODA mensagem e envia o texto do usuário ao buscador.
WEB_SEARCH_ENABLED=1
WEB_SEARCH_TIMEOUT=12
WEB_SEARCH_MODE=balanced
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# Ollama só se LLM_PROVIDER=ollama (legado/local)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b

# ── Code Analyzer: revisão profunda em múltiplas passagens ─────────────
# Só é acionada para pedidos amplos de análise/revisão de repositório.
# Cada passagem usa uma chamada ao modelo; aumentar os valores aumenta cobertura,
# tempo e consumo de tokens. Não são cotas financeiras por usuário.
GAMA_CODE_DEEP_BATCH_FILES=6
GAMA_CODE_DEEP_MAX_FILES=96
GAMA_CODE_DEEP_MAX_PASSES=16
GAMA_CODE_DEEP_CONCURRENCY=3
GAMA_CODE_DEEP_PASS_MAX_CHARS=36000
GAMA_CODE_DEEP_FILE_MAX_CHARS=12000
GAMA_CODE_DEEP_PASS_OUTPUT_TOKENS=900
# Passo 3: cruzamento final dos achados e do mapa entre subsistemas.
GAMA_CODE_DEEP_INTEGRATION_MAX_CHARS=30000
GAMA_CODE_DEEP_INTEGRATION_OUTPUT_TOKENS=1400
