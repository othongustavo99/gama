GROQ_API_KEY=gsk_xxxxxxxx
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# --- Ollama local (só desenvolvimento) ---
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434

DATA_DIR=/data
APP_NAME=Frequencia40-Gamma
APP_URL=https://sua-url.up.railway.app
