# ==============================
# GAMA - SERVIDOR (copie para .env; NUNCA commite o .env)
# ==============================

# Provedor: openrouter (padrão) ou ollama (local)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://SEU-APP.up.railway.app
OPENROUTER_APP_TITLE=Frequencia40-Gamma

# ── Segurança (OBRIGATÓRIO em produção) ───────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# O app envia essa chave em X-API-Key (flutter run --dart-define=GAMA_API_KEY=...)
GAMA_API_KEY=troque-por-uma-chave-longa
GAMA_REQUIRE_API_KEY=1
# Restrinja se tiver cliente web. Padrão "*" (apps nativos não usam CORS).
CORS_ORIGINS=*
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=120
# Proxies confiáveis na frente do app (Railway/Render = 1)
TRUSTED_PROXY_HOPS=1

# ── Modelos (confirme os IDs em openrouter.ai/models) ─────────────────
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.4-mini
CODING_MODEL=openai/gpt-5.4-mini
CONVERSATION_MODEL=openai/gpt-5.4-mini
VISION_MODEL=openai/gpt-5.4-mini
OPENROUTER_MODELS=deepseek/deepseek-chat,openai/gpt-5.4-mini
MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.6
LLM_RETRIES=3

# ── Agente com ferramentas: o modelo decide quando pesquisar/calcular/lembrar ──
AGENT_TOOLS_ENABLED=1
MAX_TOOL_ROUNDS=4
MAX_TOOL_CALLS=6

# Persistência (monte um volume em /data)
DATA_DIR=/data
APP_NAME=Frequencia40-Gamma
APP_URL=https://SEU-APP.up.railway.app

# Busca web. "balanced" pesquisa só quando faz sentido (modo clássico);
# com AGENT_TOOLS_ENABLED=1 essa heurística nem é usada. Evite "aggressive":
# ele pesquisa em TODA mensagem e envia o texto do usuário ao buscador.
WEB_SEARCH_ENABLED=1
WEB_SEARCH_TIMEOUT=12
WEB_SEARCH_MODE=balanced
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# Ollama só se LLM_PROVIDER=ollama (legado/local)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
